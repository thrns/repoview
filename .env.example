# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=

# Token hashing
SHARE_TOKEN_PEPPER=
SESSION_TOKEN_PEPPER=
IP_HASH_SALT=

# Transactional email
EMAIL_PROVIDER=smtp
EMAIL_FROM=
OPERATOR_EMAIL=

# Resend (when EMAIL_PROVIDER=resend)
RESEND_API_KEY=

# Postmark (when EMAIL_PROVIDER=postmark)
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound

# Optional secret for a trusted scheduler calling the delivery dispatcher
NOTIFICATION_DISPATCH_SECRET=

# SMTP fallback/development provider (when EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM_NAME=RepoView
